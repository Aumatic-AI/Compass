# ============================================================
# Copy this file to .env.local and fill in real values.
# .env.local is never committed to git (see .gitignore).
# ============================================================

# --- Supabase (same project you already built) ---
SUPABASE_URL=https://cxyertozokfrzcvrgrzy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- AI model (OpenAI, matching what you used in n8n) ---
OPENAI_API_KEY=your_openai_key_here

# --- Twilio (SANDBOX, for development/testing) ---
# Get these from console.twilio.com
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=+14155238886
# NOTE: Once Meta verification is done for the real client number,
# these Twilio variables get replaced with Meta Cloud API credentials
# (WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_ACCESS_TOKEN) — see README.

# --- Razorpay ---
RAZORPAY_KEY_ID=your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# --- Which client config this deployment runs (see lib/clients/) ---
CLIENT_ID=suruchi-foods
